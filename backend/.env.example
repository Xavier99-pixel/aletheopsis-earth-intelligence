# Public catalogue proxy and imagery processor
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Add after PostGIS is provisioned
DATABASE_URL=postgresql://aletheopsis:change-me@localhost:5432/aletheopsis
REDIS_URL=redis://localhost:6379/0

# Research job ledger and source/mask evidence files.
# Use a persistent-disk mount in production if records must survive redeploys.
# This runner supports one API process/instance, with two concurrent jobs.
ANALYSIS_DATA_DIR=./data/analysis

# Optional hosted evidence synthesis. These stay on the API only.
# Never enable INTELLIGENCE_ALLOW_UNAUTHENTICATED outside local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
SUPABASE_URL=
SUPABASE_ANON_KEY=
INTELLIGENCE_MAX_REQUESTS_PER_MINUTE=12
INTELLIGENCE_ALLOW_UNAUTHENTICATED=false

# Object storage for COGs, masks, renders and immutable evidence packages
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Optional one-time government administrator creation; API server ONLY.
# See docs/ADMIN_SETUP.md. Disable and remove credentials after setup.
BOOTSTRAP_ADMIN_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DEPARTMENT_ID=
BOOTSTRAP_ADMIN_EMAIL_VERIFIED=false
# Existing Supabase users: specify exact UUID; their password is never changed.
BOOTSTRAP_ADMIN_USER_ID=
