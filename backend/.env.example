# Public catalogue proxy and imagery processor
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Add after PostGIS is provisioned
DATABASE_URL=postgresql://aletheopsis:change-me@localhost:5432/aletheopsis
REDIS_URL=redis://localhost:6379/0

# Optional hosted evidence synthesis. These stay on the API only.
# Never enable INTELLIGENCE_ALLOW_UNAUTHENTICATED outside local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
SUPABASE_URL=
SUPABASE_ANON_KEY=
INTELLIGENCE_MAX_REQUESTS_PER_MINUTE=12
INTELLIGENCE_ALLOW_UNAUTHENTICATED=false

# Object storage for COGs, masks, renders and immutable evidence packages
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
